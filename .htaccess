# ════════════════════════════════════════════════════════════════════════
# .htaccess — Seguridad RH
# ════════════════════════════════════════════════════════════════════════

Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a controllers/ excepto archivos permitidos
    RewriteCond %{REQUEST_URI} ^/[^/]*/controllers/
    RewriteCond %{REQUEST_URI} !/(usuario_foto|ver_manual|descargar_archivo)\.php$ [NC]
    RewriteRule \.php$ - [F,L]

    # Bloquear acceso directo a uploads/
    RewriteRule ^uploads/ - [F,L]
</IfModule>

# Bloquear archivos sensibles
<FilesMatch "(conn\.php|security\.php|sesion\.php|logout\.php|\.env|composer\.(json|lock)|\.git)">
    Require all denied
</FilesMatch>

# Limitar métodos HTTP
<LimitExcept GET POST HEAD>
    Require all denied
</LimitExcept>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# Tamaño máximo de POST: 10 MB
LimitRequestBody 10485760

# Caché para assets estáticos
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|woff2?)$">
    Header set Cache-Control "max-age=604800, public"
</FilesMatch>